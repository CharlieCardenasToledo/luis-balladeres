# Copiar a .env.local para desarrollo. NUNCA commitear valores reales.
# En producción (Firebase App Hosting), estos valores deben venir de
# Google Secret Manager (ver plan_web_luis_balladares_ux_ui_firebase.md,
# secciones 40-41), nunca de un .env versionado.

# URL pública del sitio (usada en metadata, OG, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Firebase Client SDK (públicas, van al navegador) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SOLO SERVIDOR, nunca prefijo NEXT_PUBLIC_) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La clave privada suele necesitar comillas y \n escapados en un .env
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- Integraciones de redes sociales (sección 41 del plan) ---
# FUERA DE ALCANCE en este scaffold: no hay integración real todavía.
# Usar Secret Manager en producción, nunca commitear valores reales.
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# FACEBOOK_PAGE_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REFRESH_TOKEN=
